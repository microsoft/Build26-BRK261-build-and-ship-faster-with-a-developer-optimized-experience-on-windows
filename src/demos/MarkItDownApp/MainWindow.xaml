<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="MarkItDownApp.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:MarkItDownApp"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="MarkItDown">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid Loaded="OnLoaded">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Custom title bar -->
        <Grid x:Name="AppTitleBar" Grid.Row="0" Height="32" Padding="12,0">
            <TextBlock Text="MarkItDown"
                       VerticalAlignment="Center"
                       Style="{StaticResource CaptionTextBlockStyle}" />
        </Grid>

        <NavigationView x:Name="NavView" Grid.Row="1"
                        IsBackButtonVisible="Collapsed"
                        PaneDisplayMode="LeftCompact"
                        SelectionChanged="NavView_SelectionChanged"
                        IsSettingsVisible="False"
                        OpenPaneLength="220">

            <NavigationView.MenuItems>
                <NavigationViewItem x:Name="ConvertNavItem" Content="Convert" Tag="Convert">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE8AC;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>

                <NavigationViewItem Content="Container Log" Tag="Log">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE756;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>

            <NavigationView.PaneFooter>
                <StackPanel Padding="16,8" Spacing="8">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <FontIcon x:Name="StatusIcon" Glyph="&#xE945;" FontSize="18"
                                  Foreground="{ThemeResource TextFillColorDisabledBrush}" />
                        <TextBlock x:Name="StatusText" Text="Starting container..."
                                   VerticalAlignment="Center" FontSize="12"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </StackPanel>
            </NavigationView.PaneFooter>

            <!-- Content area -->
            <Grid>
                <!-- ===== Convert Panel ===== -->
                <Grid x:Name="ConvertPanel" Visibility="Visible">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Header bar -->
                    <Grid Grid.Row="0" Padding="16,12"
                          Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                          BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <FontIcon Glyph="&#xE8AC;" FontSize="16"
                                      Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                            <TextBlock x:Name="ConvertHeaderText" Text="Document Converter"
                                       Style="{StaticResource BodyStrongTextBlockStyle}" VerticalAlignment="Center" />
                        </StackPanel>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                            <Button x:Name="BrowseButton" Click="OnBrowseClick" ToolTipService.ToolTip="Browse for a file">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE8E5;" FontSize="14" />
                                    <TextBlock Text="Browse" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="CopyButton" Click="OnCopyClick" Visibility="Collapsed"
                                    ToolTipService.ToolTip="Copy markdown to clipboard">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE8C8;" FontSize="14" />
                                    <TextBlock Text="Copy" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="SaveButton" Click="OnSaveClick" Visibility="Collapsed"
                                    ToolTipService.ToolTip="Save markdown to file">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE74E;" FontSize="14" />
                                    <TextBlock Text="Save" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>

                    <!-- Main content area -->
                    <Grid Grid.Row="1">
                        <!-- Drop Zone (empty state) -->
                        <Grid x:Name="DropZonePanel"
                              AllowDrop="True" DragOver="OnDragOver" Drop="OnDrop">
                            <Border Margin="40" Padding="40" CornerRadius="12"
                                    Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="2">
                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="16">
                                    <FontIcon Glyph="&#xE896;" FontSize="56"
                                              Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                              HorizontalAlignment="Center" />
                                    <TextBlock Text="Drop a file here to convert to Markdown"
                                               Style="{StaticResource SubtitleTextBlockStyle}"
                                               HorizontalAlignment="Center" />
                                    <TextBlock Text="or click Browse above to select a file"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                               HorizontalAlignment="Center" />
                                    <TextBlock Text="Supports PDF, DOCX, PPTX, XLSX, HTML, CSV, JSON, XML, EPUB, images, audio, and more"
                                               Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                               FontSize="12" HorizontalAlignment="Center"
                                               TextAlignment="Center" TextWrapping="Wrap" MaxWidth="450" />
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- Progress (converting state) -->
                        <Grid x:Name="ProgressPanel" Visibility="Collapsed">
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="16">
                                <ProgressRing IsActive="True" Width="48" Height="48" />
                                <TextBlock x:Name="ProgressText" Text="Converting..."
                                           Style="{StaticResource SubtitleTextBlockStyle}"
                                           HorizontalAlignment="Center" />
                            </StackPanel>
                        </Grid>

                        <!-- Result (output state) -->
                        <Grid x:Name="ResultPanel" Visibility="Collapsed"
                              AllowDrop="True" DragOver="OnDragOver" Drop="OnDrop">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <!-- Conversion info bar -->
                            <Border Grid.Row="0" Padding="16,8"
                                    Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="0,0,0,1">
                                <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                                    <FontIcon Glyph="&#xE73E;" FontSize="14"
                                              Foreground="{ThemeResource SystemFillColorSuccessBrush}" />
                                    <TextBlock x:Name="ResultInfoText"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                               FontSize="12" VerticalAlignment="Center" />
                                    <TextBlock Text="· Drop another file to convert"
                                               Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                               FontSize="12" VerticalAlignment="Center" FontStyle="Italic" />
                                </StackPanel>
                            </Border>

                            <!-- Split: raw markdown (left) | rendered preview (right) -->
                            <Grid Grid.Row="1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <!-- Left: Raw Markdown -->
                                <Grid Grid.Column="0">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>
                                    <Border Grid.Row="0" Padding="16,6"
                                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                            BorderThickness="0,0,0,1">
                                        <TextBlock Text="Raw Markdown" FontSize="12"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                   Style="{StaticResource CaptionTextBlockStyle}" />
                                    </Border>
                                    <ScrollViewer x:Name="ResultScrollViewer" Grid.Row="1" Padding="16"
                                                  VerticalScrollBarVisibility="Auto">
                                        <TextBlock x:Name="MarkdownOutput"
                                                   FontFamily="Cascadia Code, Consolas, Courier New"
                                                   FontSize="13"
                                                   TextWrapping="Wrap"
                                                   IsTextSelectionEnabled="True"
                                                   Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                                    </ScrollViewer>
                                </Grid>

                                <!-- Splitter -->
                                <Border Grid.Column="1" Width="1"
                                        Background="{ThemeResource DividerStrokeColorDefaultBrush}" />

                                <!-- Right: Rendered Preview -->
                                <Grid Grid.Column="2">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>
                                    <Border Grid.Row="0" Padding="16,6"
                                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                            BorderThickness="0,0,0,1">
                                        <TextBlock Text="Preview" FontSize="12"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                   Style="{StaticResource CaptionTextBlockStyle}" />
                                    </Border>
                                    <WebView2 x:Name="PreviewWebView" Grid.Row="1" />
                                </Grid>
                            </Grid>
                        </Grid>
                    </Grid>
                </Grid>

                <!-- ===== Container Log Panel ===== -->
                <Grid x:Name="LogPanel" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Padding="16,12"
                          Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                          BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <FontIcon Glyph="&#xE756;" FontSize="16"
                                      Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                            <TextBlock x:Name="LogHeaderText" Text="Container Log"
                                       Style="{StaticResource BodyStrongTextBlockStyle}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Grid>

                    <ScrollViewer x:Name="LogScrollViewer" Grid.Row="1" Padding="16"
                                  VerticalScrollBarVisibility="Auto">
                        <TextBlock x:Name="LogTextBlock"
                                   FontFamily="Cascadia Code, Consolas, Courier New"
                                   FontSize="13"
                                   TextWrapping="Wrap"
                                   IsTextSelectionEnabled="True"
                                   Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                    </ScrollViewer>
                </Grid>
            </Grid>
        </NavigationView>
    </Grid>
</Window>
